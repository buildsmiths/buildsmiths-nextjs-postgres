## Copy to .env.local. A first Vercel import can omit these; the app boots in setup mode.

# Public site URL (include protocol). On Vercel this falls back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string (needed for sign-in, register, and live dashboard data)
DATABASE_URL=postgresql://user:password@localhost:5432/app

# Auth.js session secret. AUTH_SECRET is preferred; NEXTAUTH_SECRET still works.
# openssl rand -base64 32
AUTH_SECRET=X
# NEXTAUTH_SECRET=X

# Optional locally. On Vercel, NextAuth infers the URL from VERCEL_URL.
# NEXTAUTH_URL=http://localhost:3000

# --- Blueprints ---
# See blueprints/auth-google.md for Google keys
