## Copy to .env.local and set these values

# Public site URL (include protocol)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string
DATABASE_URL=X

# Strong random secret for Auth.js
NEXTAUTH_SECRET=X

# Optional locally. On Vercel, NextAuth can use VERCEL_URL when this is unset.
# NEXTAUTH_URL=http://localhost:3000

# --- Blueprints ---
# See blueprints/auth-google.md for Google keys
